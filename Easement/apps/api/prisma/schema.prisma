generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  consumer
  business_owner
  staff
  admin
}

enum BusinessStatus {
  pending
  approved
  rejected
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
  no_show
}

enum PaymentMethod {
  cash
  card_in_person
}

enum BookingSource {
  marketplace
  owner
}

enum NotificationType {
  booking_confirmed
  booking_rescheduled
  booking_cancelled
  review_request
  reminder
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  phone            String?
  passwordHash     String
  role             UserRole
  remindersEnabled Boolean  @default(true)
  /// Bumped on password change to invalidate other sessions.
  sessionVersion   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ownedBusinesses Business[]     @relation("BusinessOwner")
  staffProfiles   Staff[]
  bookings        Booking[]      @relation("ConsumerBookings")
  reviews         Review[]
  favorites       Favorite[]
  notifications   Notification[]
}

model Business {
  id          String         @id @default(cuid())
  ownerId     String
  name        String
  category    String
  description String?
  /// Public gallery image URLs for the venue profile
  portfolio   String[]       @default([])
  status      BusinessStatus @default(pending)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  owner     User       @relation("BusinessOwner", fields: [ownerId], references: [id])
  locations Location[]
  staff     Staff[]
  services  Service[]
  bookings  Booking[]
  taxRates  TaxRate[]
  sales     Sale[]
  reviews   Review[]
  favorites Favorite[]
  googleCalendar GoogleCalendarConnection?

  @@index([ownerId])
}

model Location {
  id         String   @id @default(cuid())
  businessId String
  name       String
  address    String
  lat        Float
  lng        Float
  timezone   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff[]
  bookings Booking[]
  sales    Sale[]

  @@index([businessId])
}

model Staff {
  id         String   @id @default(cuid())
  businessId String
  locationId String
  userId     String?
  name       String
  email      String?
  phone      String?
  title      String
  photoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location     Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id])
  services     StaffService[]
  availability Availability[]
  timeOff      TimeOff[]
  bookings     Booking[]
  sales        Sale[]

  @@index([businessId])
  @@index([locationId])
  @@index([userId])
}

model Service {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  durationMinutes Int
  price           Float
  category        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    StaffService[]
  bookings Booking[]
  sales    Sale[]

  @@index([businessId])
}

model StaffService {
  staffId   String
  serviceId String
  createdAt DateTime @default(now())

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([staffId])
  @@index([serviceId])
}

model Availability {
  id        String   @id @default(cuid())
  staffId   String
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime String   // e.g. "09:00"
  endTime   String   // e.g. "17:00"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model TimeOff {
  id            String   @id @default(cuid())
  staffId       String
  startDatetime DateTime
  endDatetime   DateTime
  reason        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model Booking {
  id            String        @id @default(cuid())
  consumerId    String?
  businessId    String
  locationId    String
  staffId       String
  serviceId     String
  startDatetime DateTime
  endDatetime   DateTime
  status        BookingStatus @default(confirmed)
  source        BookingSource @default(marketplace)
  price         Float
  notes         String?
  guestName     String?
  guestEmail    String?
  guestPhone    String?
  googleEventId String?
  reminderAt    DateTime?
  reminderSentAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  consumer User?    @relation("ConsumerBookings", fields: [consumerId], references: [id])
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  sale     Sale?
  review   Review?

  @@index([consumerId])
  @@index([businessId])
  @@index([locationId])
  @@index([staffId])
  @@index([startDatetime, endDatetime])
}

model GoogleCalendarConnection {
  id           String   @id @default(cuid())
  businessId   String   @unique
  refreshToken String
  accessToken  String?
  accessTokenExpiresAt DateTime?
  calendarId   String   @default("primary")
  connectedEmail String?
  status       String   @default("active")
  lastError    String?
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model TaxRate {
  id         String   @id @default(cuid())
  businessId String
  name       String
  percentage Float    // e.g. 8.875
  isDefault  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Sale {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  businessId    String
  locationId    String
  staffId       String
  serviceId     String
  subtotal      Float
  taxAmount     Float
  total         Float
  paymentMethod PaymentMethod @default(cash)
  soldAt        DateTime      @default(now())

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([locationId])
  @@index([staffId])
  @@index([soldAt])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  consumerId String
  businessId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  consumer User     @relation(fields: [consumerId], references: [id])
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([consumerId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  href      String?
  bookingId String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}
