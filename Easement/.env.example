# Copy to apps/api/.env and apps/web/.env.local as needed

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://ezment:ezment@localhost:5432/ezment?schema=public"

# Redis (used in later steps for booking locks / queues)
REDIS_URL="redis://localhost:6379"

# NestJS API
PORT=3003
SESSION_SECRET="change-me-to-a-long-random-string"
CORS_ORIGIN="http://localhost:3000"
COOKIE_SECURE=false

# Booking abuse limits (pay-at-venue calendar protection)
BOOKING_MAX_ADVANCE_DAYS=60
BOOKING_MAX_UPCOMING=5
BOOKING_MAX_UPCOMING_PER_BUSINESS=3
BOOKING_MAX_CREATES_PER_HOUR=8

# Email (optional — without RESEND_API_KEY, mail is logged to the API console)
RESEND_API_KEY=""
MAIL_FROM="Easement <onboarding@resend.dev>"
CRON_SECRET="change-me-cron-secret"

# Google Calendar (optional — owner push sync; Easement is source of truth)
# 1) Enable Google Calendar API in Google Cloud Console
# 2) Create OAuth 2.0 Web client credentials
# 3) Copy these three keys into apps/api/.env (do not commit real secrets)
# 4) Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly
# 5) Restart the API, then Dashboard -> Calendar -> Add Google Calendar
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3003/auth/google/calendar/callback"
# Optional: where OAuth callback redirects the browser (defaults to first CORS_ORIGIN)
# WEB_ORIGIN="http://localhost:3000"

# Optional: Node process TZ for logs/cron (venues still use Location.timezone; demo = Europe/Riga)
# TZ=Europe/Riga

